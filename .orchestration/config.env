# Models are intentionally empty: inherit the user's native Codex default unless
# a role-specific model is explicitly configured.
CODEX_REVIEW_MODEL=${CODEX_REVIEW_MODEL:-}
CODEX_CODE_MODEL=${CODEX_CODE_MODEL:-}
CODEX_EXEC_MODEL=${CODEX_EXEC_MODEL:-}

# Do not inject model_reasoning_effort with `codex -c` from Herdr startup.
# Modern Codex can use a shared background server; ad-hoc startup overrides may
# change how the client attaches. Configure native Codex defaults/profile if desired.
CODEX_HEAVY_THRESHOLD=${CODEX_HEAVY_THRESHOLD:-30}

PEER_POLL_SECONDS=${PEER_POLL_SECONDS:-15}
PEER_LIMIT_POLL_SECONDS=${PEER_LIMIT_POLL_SECONDS:-600}
PEER_IDLE_GRACE_SECONDS=${PEER_IDLE_GRACE_SECONDS:-30}
