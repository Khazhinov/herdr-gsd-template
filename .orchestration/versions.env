# Compatibility baseline verified for this template on 2026-11-02.
# GSD is pinned because its installer changes project-local runtime artifacts.
GSD_VERSION=${GSD_VERSION:-1.19.0}

# Native tools are user-installed. doctor.sh accepts newer compatible releases.
HC_MIN_VERSION=${HC_MIN_VERSION:-0.1.16}
CLAUDE_MIN_VERSION=${CLAUDE_MIN_VERSION:-2.1.316}
CODEX_MIN_VERSION=${CODEX_MIN_VERSION:-0.165.0}
NODE_MIN_MAJOR=${NODE_MIN_MAJOR:-24}
NPM_MIN_MAJOR=${NPM_MIN_MAJOR:-10}
PYTHON_MIN_VERSION=${PYTHON_MIN_VERSION:-3.11.0}
