# Compatibility baseline verified for this template on 2026-10-16.
# GSD is pinned because its installer changes project-local runtime artifacts.
GSD_VERSION=${GSD_VERSION:-1.17.0}

# Native tools are user-installed. doctor.sh accepts newer compatible releases.
HERDR_MIN_VERSION=${HERDR_MIN_VERSION:-0.9.3}
CLAUDE_MIN_VERSION=${CLAUDE_MIN_VERSION:-2.1.301}
CODEX_MIN_VERSION=${CODEX_MIN_VERSION:-0.163.0}
NODE_MIN_MAJOR=${NODE_MIN_MAJOR:-24}
NPM_MIN_MAJOR=${NPM_MIN_MAJOR:-10}
PYTHON_MIN_VERSION=${PYTHON_MIN_VERSION:-3.10.0}
